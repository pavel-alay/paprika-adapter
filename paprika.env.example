# Copy to ~/.config/paprika-adapter/paprika.env and chmod 600. Never commit the copy.
PAPRIKA_EMAIL=you@example.com
PAPRIKA_PASSWORD=change-me

# Read-only is the default. Set to true only after the read-only checks in docs/INSTALL.md pass.
PAPRIKA_ENABLE_WRITES=false
# auto  = ask the user through MCP elicitation when the client supports it
# human = refuse to write unless the client supports it
PAPRIKA_APPROVAL=auto

# Zone that decides "today" and "this week" (the container itself runs in UTC).
PAPRIKA_TZ=UTC

# PAPRIKA_MAX_AGE=5m          cached data older than this is re-checked before it is served
# PAPRIKA_SYNC_INTERVAL=15m   background refresh while the server runs; 0 turns it off
# PAPRIKA_LOG_LEVEL=info      debug | info | warn | error (logs go to stderr)
